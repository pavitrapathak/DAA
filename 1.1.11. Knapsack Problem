#include <stdio.h>

int main() {
    int N, W;

    scanf("%d", &N);

    int value[N];
    int weight[N];

    for (int i = 0; i < N; i++) {
        scanf("%d", &value[i]);
    }

    for (int i = 0; i < N; i++) {
        scanf("%d", &weight[i]);
    }

    scanf("%d", &W);

    int dp[W + 1];

  
    for (int w = 0; w <= W; w++) {
        dp[w] = 0;
    }


    for (int i = 0; i < N; i++) {

        for (int w = W; w >= weight[i]; w--) {

            int include = value[i] + dp[w - weight[i]];

            if (include > dp[w]) {
                dp[w] = include;
            }
        }
    }

    printf("%d\n", dp[W]);

    return 0;
}
