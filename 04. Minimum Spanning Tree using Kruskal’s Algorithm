#include <stdio.h>
#include <stdlib.h>
#include <limits.h>
void kruskalMST(int **cost, int V) {

    struct Edge {
        int u, v, weight, order;
    };

    int maxEdges = V * (V - 1) / 2;
    struct Edge *edges = (struct Edge *)malloc(maxEdges * sizeof(struct Edge));

    int edgeCount = 0;
    for (int i = 0; i < V; i++) {
        for (int j = i + 1; j < V; j++) {
            if (cost[i][j] != 9999) {
                edges[edgeCount].u = i;
                edges[edgeCount].v = j;
                edges[edgeCount].weight = cost[i][j];
                edges[edgeCount].order = edgeCount;
                edgeCount++;
            }
        }
    }
    for (int i = 0; i < edgeCount - 1; i++) {
        for (int j = 0; j < edgeCount - i - 1; j++) {

            if (edges[j].weight > edges[j + 1].weight ||
                (edges[j].weight == edges[j + 1].weight &&
                 edges[j].order > edges[j + 1].order)) {

                struct Edge temp = edges[j];
                edges[j] = edges[j + 1];
                edges[j + 1] = temp;
            }
        }
    }
    int *parent = (int *)malloc(V * sizeof(int));

    for (int i = 0; i < V; i++)
        parent[i] = i;

    int (*find)(int);

    int mstEdges = 0;
    int totalCost = 0;

    for (int i = 0; i < edgeCount && mstEdges < V - 1; i++) {

        int u = edges[i].u;
        int v = edges[i].v;

        int rootU = u;
        while (parent[rootU] != rootU)
            rootU = parent[rootU];

        
        while (parent[u] != u) {
            int temp = parent[u];
            parent[u] = rootU;
            u = temp;
        }

        int rootV = v;
        while (parent[rootV] != rootV)
            rootV = parent[rootV];

    
        while (parent[v] != v) {
            int temp = parent[v];
            parent[v] = rootV;
            v = temp;
        }
        if (rootU != rootV) {
            parent[rootU] = rootV;

            printf("Edge %d:(%d, %d) cost:%d\n",
                   mstEdges, edges[i].u, edges[i].v, edges[i].weight);

            totalCost += edges[i].weight;
            mstEdges++;
        }
    }

    printf("Minimum cost= %d\n", totalCost);

    free(parent);
    free(edges);
}
int main() {
    int V;
    printf("No of vertices: ");
    scanf("%d", &V);

    int **cost = (int **)malloc(V * sizeof(int *));
    for (int i = 0; i < V; i++)
        cost[i] = (int *)malloc(V * sizeof(int));

    printf("Adjacency matrix:\n");
    for (int i = 0; i < V; i++)
        for (int j = 0; j < V; j++)
            scanf("%d", &cost[i][j]);

    kruskalMST(cost, V);

    for (int i = 0; i < V; i++)
        free(cost[i]);
    free(cost);

    return 0;
}
